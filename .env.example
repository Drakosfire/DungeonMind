# DungeonMind configuration template.
# Copy to .env and fill in environment-specific values. Never commit .env.
# The dungeonmind core package imports with NONE of these set; each variable is
# consumed by a specific optional adapter or service slice (noted per variable).

# --- PostgreSQL/pgvector substrate (PR B) -------------------------------------
# Ownership: the deployment layer provisions the server, network, volume, and
# credentials; DungeonMind owns schema, migrations, and repository adapters.
DUNGEONMIND_DATABASE_URL=postgresql://dungeonmind:CHANGE_ME@127.0.0.1:5432/dungeonmind
DUNGEONMIND_DB_SCHEMA=dungeonmind

# --- Embedding / retrieval configuration (PR D) --------------------------------
# Model identity is configuration, never code. A production model change requires
# benchmark evidence (see Docs/Decisions/ADR-0003 and RulesIngestion discipline).
DUNGEONMIND_EMBEDDING_MODEL=
DUNGEONMIND_EMBEDDING_MODEL_REVISION=
# Retrieval backend selection: memory (dev/tests) | postgres (PR B+)
DUNGEONMIND_RETRIEVAL_BACKEND=memory

# --- Service API host (successor slice) ----------------------------------------
DUNGEONMIND_API_HOST=127.0.0.1
DUNGEONMIND_API_PORT=8080
